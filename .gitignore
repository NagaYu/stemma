# --------------------------------------------------------------------------- #
# Stemma-specific
# --------------------------------------------------------------------------- #
# Generated benchmark checkpoints: real safetensors, hundreds of MB, and fully
# reproducible from `python scripts/build_bench.py`. Never commit them.
bench_models/
.stemma_cache/
# On-disk safetensors-header / model-card cache (default ~/.cache/stemma, but a
# repo-local one appears when STEMMA_CACHE is set to a relative path).
.cache/stemma/
stemma-index.npz
stemma-index.json
# Packaged artifact staging directories written by scripts/push_model.py and
# scripts/push_space.py.
hf_model_export/
hf_space_export/
# Run outputs
bom.json
bom.spdx.json
phylogeny.mmd
phylogeny.dot

# figures/ and benchmarks/results.json are deliberately TRACKED: the plots and
# the measured numbers are part of the published record and are referenced by
# README.md / MODEL_CARD.md.
!figures/
!figures/**

